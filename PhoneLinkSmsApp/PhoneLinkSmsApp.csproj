<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PhoneLinkSms</AssemblyName>
    <RootNamespace>PhoneLinkSmsApp</RootNamespace>
    <Product>단체문자발송</Product>
    <Description>'휴대폰과 연결' 앱으로 엑셀 명단에 문자를 보내는 프로그램</Description>
    <Version>1.2.0</Version>
    <!-- 아이콘 원본 생성기: ..\tools\IconGen (README 참고) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- dotnet publish 시: .NET 설치 없이 실행되는 단일 exe -->
  <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF 프로젝트는 암시적 using에서 System.IO를 뺀다 -->
    <Using Include="System.IO" />
    <Resource Include="Assets\app.ico" />
    <InternalsVisibleTo Include="PhoneLinkSmsApp.Tests" />
  </ItemGroup>

</Project>
