<UserControl x:Class="PhoneLinkSmsApp.Views.Step4Send"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <DockPanel Margin="28,22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TitleText" Style="{StaticResource StepTitle}" Text="문자를 보내는 중입니다"/>
            <TextBlock x:Name="DescText" Style="{StaticResource StepDesc}" Text="끝날 때까지 이 창을 닫지 마세요."/>
        </StackPanel>

        <!-- 발송 중 경고 -->
        <Border x:Name="WarningBanner" DockPanel.Dock="Top" Background="{StaticResource WarningSoftBrush}" BorderBrush="#F59E0B"
                BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="⚠" FontSize="24" Foreground="#B45309" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel>
                    <TextBlock Text="마우스와 키보드를 만지지 마세요" FontWeight="Bold" FontSize="15" Foreground="#92400E"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#92400E" Margin="0,2,0,0"
                               Text="프로그램이 '휴대폰과 연결' 앱을 직접 조작하고 있습니다. 멈추려면 오른쪽 [중단]을 누르세요. 지금 보내는 1건은 마저 보낸 뒤 멈춥니다."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 결과 안내 (끝난 뒤) -->
        <Border x:Name="ResultBanner" DockPanel.Dock="Top" CornerRadius="8" Padding="16,12" Margin="0,0,0,14" BorderThickness="1" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="ResultIcon" DockPanel.Dock="Left" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="ResumeButton" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="16,7" Margin="8,0,0,0" Click="OnResume"/>
                    <Button x:Name="RetryButton" Content="실패한 사람만 다시 보내기" Margin="8,0,0,0" Click="OnRetryFailed"/>
                </WrapPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ResultTitle" FontWeight="Bold" FontSize="15"/>
                    <TextBlock x:Name="ResultDetail" TextWrapping="Wrap" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 진행 상황 -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel>
                    <StackPanel x:Name="ControlPanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PauseButton" Content="일시정지" Click="OnPause"/>
                        <Button x:Name="StopButton" Content="■  중단" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="OnStop"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock x:Name="DoneCountText" FontSize="30" FontWeight="Bold"/>
                        <TextBlock x:Name="TotalCountText" FontSize="16" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,5"/>
                    </StackPanel>
                </DockPanel>
                <ProgressBar x:Name="SendProgressBar" Height="12" Margin="0,12,0,10"/>
                <DockPanel x:Name="CurrentRow">
                    <TextBlock x:Name="RemainingText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock x:Name="CurrentText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Border CornerRadius="12" Background="{StaticResource SuccessSoftBrush}" Padding="12,4" Margin="0,0,8,0">
                        <TextBlock x:Name="SentChip" Foreground="#166534" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="12" Background="{StaticResource DangerSoftBrush}" Padding="12,4" Margin="0,0,8,0">
                        <TextBlock x:Name="FailedChip" Foreground="#B91C1C" FontWeight="SemiBold"/>
                    </Border>
                    <Border CornerRadius="12" Background="#E5E7EB" Padding="12,4" Margin="0,0,8,0">
                        <TextBlock x:Name="PendingChip" Foreground="#374151" FontWeight="SemiBold"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- 상세 로그 -->
        <Expander DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Expander.Header>
                <DockPanel>
                    <TextBlock Text="상세 기록 보기" Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
            </Expander.Header>
            <StackPanel Margin="0,8,0,0">
                <TextBox x:Name="LogBox" Height="120" IsReadOnly="True" FontFamily="Consolas, Malgun Gothic" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                <Button Content="로그 폴더 열기 (CSV·스크린샷)" HorizontalAlignment="Left" Margin="0,8,0,0" FontWeight="Normal" Click="OnOpenLogFolder"/>
            </StackPanel>
        </Expander>

        <!-- 사람별 상태 -->
        <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Sending">
                            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Sent">
                            <Setter Property="Foreground" Value="#047857"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                            <Setter Property="Foreground" Value="#B91C1C"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="순번" Binding="{Binding SendIndex}" Width="56"/>
                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="120"/>
                <DataGridTextColumn Header="전화번호" Binding="{Binding NormalizedPhone}" Width="150"/>
                <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="90"/>
                <DataGridTextColumn Header="안내" Binding="{Binding StatusMessage}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
