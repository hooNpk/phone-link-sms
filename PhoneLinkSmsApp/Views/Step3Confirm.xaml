<UserControl x:Class="PhoneLinkSmsApp.Views.Step3Confirm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Style="{StaticResource StepTitle}" Text="보내기 전에 확인하세요"/>
            <TextBlock Style="{StaticResource StepDesc}" Text="오른쪽 순서대로 준비를 마치면 [전체 발송 시작] 버튼이 켜집니다."/>
        </StackPanel>

        <!-- ── 왼쪽: 무엇을 누구에게 ── -->
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,24,0">
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TargetText" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="에게 보냅니다" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="6,0,0,6"/>
                    </StackPanel>
                    <TextBlock x:Name="ExcludedText" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                        <TextBlock x:Name="EstimateText"/>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="보낼 내용" Style="{StaticResource SectionTitle}"/>
                    <TextBlock x:Name="PreviewNote" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="13" Margin="0,-2,0,8" Visibility="Collapsed"/>
                    <Border Background="{StaticResource PageBrush}" CornerRadius="8" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Border Background="White" CornerRadius="14,14,14,4" Padding="12,10" HorizontalAlignment="Left" VerticalAlignment="Top" MaxWidth="420">
                                <StackPanel>
                                    <Image x:Name="PreviewImage" MaxHeight="200" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="PreviewText" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ── 오른쪽: 준비 순서 ── -->
        <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 연결 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border x:Name="Badge1" DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock x:Name="Badge1Text" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="다시 확인" Padding="10,4" FontWeight="Normal" Click="OnRefreshConnection"/>
                                <TextBlock Text="휴대폰 연결 확인" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="StatusHelp" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed"
                                       Text="PC의 '휴대폰과 연결' 앱을 열고, 휴대폰에서 'Windows와 연결'이 켜져 있는지 확인한 뒤 [다시 확인]을 누르세요."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 2. 테스트 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <DockPanel>
                        <Border x:Name="Badge2" DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Top" Margin="0,0,12,0">
                            <TextBlock x:Name="Badge2Text" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="나에게 먼저 보내 보기 (필수)" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,10"
                                       Text="내 번호로 1건을 보내 문구와 사진이 제대로 가는지 확인합니다. {이름}은 첫 번째 받는 사람 이름으로 채워집니다."/>
                            <DockPanel>
                                <Button x:Name="TestButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="16,7"
                                        Content="테스트 발송" Margin="8,0,0,0" Click="OnTestSend"/>
                                <Grid>
                                    <TextBox x:Name="TestPhoneBox" TextChanged="OnTestPhoneChanged"/>
                                    <TextBlock x:Name="TestPhonePlaceholder" Text="내 휴대폰 번호 (010-...)" IsHitTestVisible="False"
                                               Foreground="#9CA3AF" Margin="11,0" VerticalAlignment="Center"/>
                                </Grid>
                            </DockPanel>
                            <Border x:Name="TestResultBox" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TestStatus" TextWrapping="Wrap"/>
                                    <Button x:Name="TestLogLink" Style="{StaticResource LinkButton}" Margin="0,6,0,0" HorizontalAlignment="Left"
                                            Content="실패 순간의 화면과 기록 보기" Visibility="Collapsed" Click="OnOpenTestLog"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 선택: 간격 -->
                <Expander Margin="0,4,0,0">
                    <Expander.Header>
                        <TextBlock x:Name="IntervalHeader" Foreground="{StaticResource MutedBrush}"/>
                    </Expander.Header>
                    <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Label}" Text="한 건 보낸 뒤"/>
                                <TextBox x:Name="IntervalBox" Width="60" TextChanged="OnIntervalChanged" HorizontalContentAlignment="Center"/>
                                <TextBlock Style="{StaticResource Label}" Text="초 쉬기" Margin="6,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="보통은 0초로 두세요. 통신사에서 스팸으로 막힐까 걱정되면 5~10초로 늘리세요 (그만큼 오래 걸립니다)."/>
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
