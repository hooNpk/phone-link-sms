<UserControl x:Class="PhoneLinkSmsApp.Views.Step0Connect"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22" MaxWidth="820" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource StepTitle}" Text="휴대폰이 연결되어 있는지 확인할게요"/>
            <TextBlock Style="{StaticResource StepDesc}"
                       Text="이 프로그램은 PC의 '휴대폰과 연결' 앱과 휴대폰의 'Windows와 연결'을 통해 내 휴대폰으로 문자를 보냅니다. PC와 휴대폰 양쪽이 모두 켜져 있어야 합니다."/>

            <!-- ── 현재 상태 ── -->
            <Border x:Name="StatusCard" CornerRadius="12" BorderThickness="1" Padding="22,18">
                <DockPanel>
                    <Button x:Name="RecheckButton" DockPanel.Dock="Right" Content="다시 확인" VerticalAlignment="Center" Click="OnRecheck"/>
                    <Border x:Name="StatusIconBox" DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="26" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusIcon" Foreground="White" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="StatusDetail" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock x:Name="AutoCheckText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="연결되면 자동으로 알아챕니다. 이 화면을 켜 둔 채로 아래 순서를 따라 해 주세요."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 상태를 읽지 못했을 때: 사용자가 직접 확인 -->
            <Border x:Name="ManualConfirmBox" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12" Visibility="Collapsed">
                <CheckBox x:Name="ManualConfirmCheck" Click="OnManualConfirm">
                    <TextBlock TextWrapping="Wrap"
                               Text="'휴대폰과 연결' 앱 화면에서 내 휴대폰이 '연결됨'으로 표시되는 것을 직접 확인했습니다."/>
                </CheckBox>
            </Border>

            <!-- ── 연결 방법 안내 ── -->
            <StackPanel x:Name="GuidePanel" Margin="0,22,0,0">
                <TextBlock Text="연결하는 방법" Style="{StaticResource SectionTitle}" Margin="0,0,0,12"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Button x:Name="LaunchButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" FontSize="14" Padding="16,7"
                                Content="'휴대폰과 연결' 앱 열기" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnLaunch"/>
                        <StackPanel>
                            <TextBlock Text="PC에서 '휴대폰과 연결' 앱을 엽니다" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="오른쪽 버튼을 누르거나, 시작 메뉴에서 '휴대폰과 연결'을 검색해 실행하세요. 앱 창을 닫지 말고 켜 두어야 합니다."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 휴대폰 쪽: 'Windows와 연결' -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock FontWeight="Bold" TextWrapping="Wrap">
                                <Run Text="휴대폰에서 "/><Run Text="'Windows와 연결'" Foreground="{StaticResource AccentBrush}"/><Run Text="을 켭니다"/>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,8"
                                       Text="PC 앱만 켜서는 안 됩니다. 휴대폰 쪽도 켜져 있어야 연결됩니다."/>
                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="• 삼성 갤럭시: " FontWeight="SemiBold"/><Run Text="화면 위에서 아래로 두 번 내려 빠른 설정 패널을 열고 'Windows와 연결'을 켜세요. (또는 설정 → 연결된 기기 → Windows와 연결)"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
                                        <Run Text="• 다른 안드로이드 폰: " FontWeight="SemiBold"/><Run Text="Play 스토어에서 'Windows와 연결' 앱을 설치해 열고 로그인하세요."/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="• 처음 쓰는 PC라면: " FontWeight="SemiBold"/><Run Text="PC 앱에 뜨는 QR 코드를 휴대폰으로 스캔해 한 번 짝지어 주세요."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="휴대폰 화면을 켜고 블루투스·와이파이를 켭니다" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="휴대폰이 잠들어 있으면 '오프라인'으로 보일 수 있습니다. 화면을 한 번 켜 주고, PC와 가까이 두세요. 계속 오프라인이면 휴대폰 설정 → 애플리케이션 → 'Windows와 연결' → 배터리에서 '제한 없음'으로 바꿔 주세요."/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,14">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                            <TextBlock Text="4" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="앱 화면에 '연결됨'이 보이는지 확인합니다" FontWeight="Bold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                                       Text="앱 왼쪽 위 휴대폰 이름 아래에 '연결됨'이 보이고, '메시지' 탭에서 문자 목록이 보이면 준비가 끝난 것입니다."/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
