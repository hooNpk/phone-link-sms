<UserControl x:Class="PhoneLinkSmsApp.Views.Step2Compose"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ── 왼쪽: 작성 ── -->
        <DockPanel Grid.Column="0" Margin="0,0,24,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Style="{StaticResource StepTitle}" Text="무엇을 보낼까요?"/>
                <TextBlock Style="{StaticResource StepDesc}" Text="모든 사람에게 같은 문구가 갑니다. {이름}이라고 쓴 자리만 받는 사람마다 그 사람 이름으로 바뀝니다."/>
            </StackPanel>

            <!-- 사진 첨부 -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12">
                <DockPanel>
                    <Border x:Name="ThumbBox" DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="6" Margin="0,0,14,0"
                            Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="NoThumbText" Text="🖼" FontSize="22" Foreground="#9CA3AF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="ThumbImage" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="PickImageButton" Content="사진 선택..." Click="OnPickImage"/>
                        <Button x:Name="RemoveImageButton" Content="사진 빼기" Margin="8,0,0,0" Visibility="Collapsed"
                                Style="{StaticResource DangerButton}" Click="OnRemoveImage"/>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="사진 첨부 (선택)" FontWeight="Bold"/>
                        <TextBlock x:Name="ImageInfoText" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                   Text="포스터·웹자보 등 이미지를 함께 보낼 수 있습니다."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 문구 -->
            <Border Style="{StaticResource Card}" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="RecentButton" DockPanel.Dock="Right" Content="최근 문구 불러오기 ▾" Padding="12,5" FontWeight="Normal"
                                Click="OnRecentClick"/>
                        <Button DockPanel.Dock="Right" Content="+ {이름} 넣기" Padding="12,5" Margin="0,0,8,0"
                                Foreground="{StaticResource AccentBrush}" BorderBrush="{StaticResource AccentBrush}" Click="OnInsertName"
                                ToolTip="커서 위치에 {이름}을 넣습니다. 보낼 때 받는 사람마다 그 사람 이름으로 바뀝니다."/>
                        <TextBlock Text="문구" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock x:Name="NameNote" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="13" Margin="0,8,0,0" Visibility="Collapsed"/>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Border x:Name="KindBadge" DockPanel.Dock="Left" CornerRadius="10" Padding="10,3" Margin="0,0,10,0">
                            <TextBlock x:Name="KindText" FontSize="12" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="CounterText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Text="한글 45자(90바이트)를 넘으면 장문으로 보내집니다"/>
                    </DockPanel>

                    <Grid>
                        <TextBox x:Name="MessageText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top" FontSize="15" Padding="10" TextChanged="OnMessageChanged"/>
                        <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="14,12" FontSize="15" Foreground="#9CA3AF" TextWrapping="Wrap"
                                   Text="여기에 보낼 문구를 입력하세요.&#10;&#10;예) {이름}님, 안녕하세요. 정의당 수원시위원회입니다. 이번 주 토요일 당원 모임에 초대합니다.&#10;&#10;{이름}이라고 쓰면 받는 사람마다 그 사람 이름으로 바뀝니다."/>
                    </Grid>
                </DockPanel>
            </Border>
        </DockPanel>

        <!-- ── 오른쪽: 받는 사람 화면 미리보기 ── -->
        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="받는 사람 화면 미리보기" Style="{StaticResource SectionTitle}" Margin="0,6,0,12"/>
            <Border CornerRadius="28" Background="#1F2937" Padding="10" MaxHeight="600" VerticalAlignment="Top">
                <Border CornerRadius="20" Background="#F3F4F6">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Background="White" CornerRadius="20,20,0,0" Padding="14,12"
                                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="나" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="내 휴대폰 번호" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,14" MinHeight="380">
                            <StackPanel>
                                <TextBlock x:Name="PreviewEmpty" Text="문구를 입력하면 여기에 보입니다" Style="{StaticResource Hint}"
                                           HorizontalAlignment="Center" Margin="0,120,0,0"/>
                                <Border x:Name="PreviewBubble" Background="White" CornerRadius="14,14,14,4" Padding="12,10"
                                        HorizontalAlignment="Left" MaxWidth="250" Visibility="Collapsed">
                                    <StackPanel>
                                        <Image x:Name="PreviewImage" MaxHeight="220" Margin="0,0,0,8" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="PreviewText" TextWrapping="Wrap" FontSize="13"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
